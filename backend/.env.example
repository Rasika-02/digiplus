# SQLite works out of the box; switch to Postgres for deployment
DATABASE_URL=sqlite:///./apollocare.db
# DATABASE_URL=postgresql+psycopg://apollo:apollo@localhost:5432/apollocare
JWT_SECRET=change-me-to-a-long-random-string
# Leave OPENAI_API_KEY empty: tasks/handovers still work, briefs use rule-based fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
LOG_FILE=logs/app.log
LOG_LEVEL=INFO
